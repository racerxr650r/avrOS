#ifndef BTN_H_
#define BTN_H_

// Includes -------------------------------------------------------------------
#include "../avrOS.h"

// Constants ------------------------------------------------------------------
#define BTN_CHANGE_EVENT        EVENT_TYPE_1
#define BTN_PRESS_EVENT         EVENT_TYPE_2
#define BTN_RELEASE_EVENT       EVENT_TYPE_3
#define BTN_EDGE_EVENT			EVENT_TYPE_4

#define DEBOUNCE_DELAY			10

// Types ----------------------------------------------------------------------
typedef struct
{
	uint16_t	press, release, handled;
}btnStats_t;

typedef struct 
{
	bool            state;
	fsmHandler_t    *nextState;
#ifdef BTN_STATS
	btnStats_t;
#endif
}button_t;

typedef struct
{
	gpio_t		*gpio;
	button_t	*status;
}btnDescr_t;


// Macros ---------------------------------------------------------------------
#define ADD_BUTTON(gpio)

#endif // BTN_H_