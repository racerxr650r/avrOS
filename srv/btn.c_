// External functions ----------------------------------------------------------
int btnWait(btn_t *button, evntType_t filter/*, fsmHandler_t nextState*/)
{
	volatile fsmStateMachine_t *stateMachine = fsmGetCurrentStateMachine();

	evntEnable(button->event,filter,btnHandler,stateMachine);

}